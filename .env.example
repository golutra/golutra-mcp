# dev/canary requires the absolute path of the matching build. Updated
# Golutra member terminals inherit this from their Host. Standalone clients
# must configure it. Stable can still discover the installed CLI when unset.
GOLUTRA_CLI_PATH=/absolute/path/to/golutra-cli
# Optional. Unset profile/host delegates to CLI discovery. An inherited
# GOLUTRA_RUNTIME_PROFILE is respected. No cross-runtime command replay.
GOLUTRA_PROFILE=
GOLUTRA_CLI_HOST_KIND=
GOLUTRA_TARGET_ORDER=
# Deprecated: target order accepts a single explicit target only, e.g. dev:server.
GOLUTRA_WORKSPACE_PATH=/absolute/path/to/workspace
GOLUTRA_COMMAND_TIMEOUT_MS=30000

# Optional end-to-end smoke test inputs for `npm run test:e2e`.
GOLUTRA_E2E_CLI_PATH=/absolute/path/to/golutra-cli
GOLUTRA_E2E_WORKSPACE_PATH=/absolute/path/to/workspace
GOLUTRA_E2E_PROFILE=stable
# Optional. When set, the smoke test also verifies the app-backed
# `chat.conversations.list` probe through `golutra-diagnose`.
GOLUTRA_E2E_USER_ID=
